{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:match*",
      "destination": "/app/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
